// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String    @id @default(uuid())
  name          String
  phone         String?
  targetAmount  Int       @map("target_amount")
  dpAmount      Int       @map("dp_amount")
  dpPaid        Boolean   @default(false) @map("dp_paid")
  createdAt     DateTime  @default(now()) @map("created_at")
  payments      Payment[]
  votes         Vote[]

  @@map("members")
}

model Payment {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  type      String   // 'dp', 'savings', 'full'
  amount    Int
  date      DateTime @db.Date
  note      String?
  proof     String?  // URL/link to bukti pembayaran (screenshot/struk)
  createdAt DateTime @default(now()) @map("created_at")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model VillaPolling {
  id            String    @id @default(uuid())
  name          String
  imageUrl      String?   @map("image_url")
  imageUrls     String[]  @default([]) @map("image_urls")
  capacity      Int       @default(0)
  facilities    String[]  @default([])
  description   String?
  price         Int       @default(0)
  link          String?
  locationLink  String?   @map("location_link")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  votes         Vote[]

  @@map("villa_pollings")
  @@index([isActive])
}

model Vote {
  id            String       @id @default(uuid())
  memberId      String       @map("member_id") // changed to unique per voting rule
  villaId       String       @map("villa_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  villa         VillaPolling @relation(fields: [villaId], references: [id], onDelete: Cascade)

  // One member can only have one vote total (if they want to change, they update this row)
  @@unique([memberId])
  @@index([villaId])
  @@map("votes")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model Expense {
  id        String   @id @default(uuid())
  name      String
  amount    Int
  category  String   // 'villa', 'transport', 'konsumsi', 'lainnya'
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@map("expenses")
}
